+
+def _convert_value(val):
+    if isinstance(val, str):
+        lowered = val.strip().lower()
+        if lowered in BOOLEANS_TRUE:
+            return True
+        if lowered in BOOLEANS_FALSE:
+            return False
+    return val
 
 
